NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated), or * for any. Mobile apps don't need CORS.
CORS_ORIGINS=https://myadmin.instantdoctor.co,http://localhost:3000,http://localhost:3001
PUBLIC_BASE_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────────────────────────
# Switch targets with DB_TARGET (or per command: npm run dev:live, db:migrate:live, ...).
DB_TARGET=local
# MAMP MySQL defaults: user root / password root on port 8889
DATABASE_URL_LOCAL=mysql://root:root@127.0.0.1:8889/instant_doctor
# TiDB Cloud (Serverless): Connect → "General" → copy host/user/password, e.g.
# mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/instant_doctor
DATABASE_URL_LIVE=
# auto = TLS on for live, off for local. Set DATABASE_SSL_CA only for TiDB Dedicated.
DATABASE_SSL=auto
DATABASE_SSL_CA=
DATABASE_POOL_SIZE=10
# DATABASE_URL, if set, overrides all of the above (used by tests/containers).

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Service account JSON for FCM push + the one-off Firestore migration (never commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=../instantdoctorapi/serverKey.json
# Legacy Firebase web API key: lets migrated users log in with their Firebase password
# once, after which a local hash is stored. Remove after the transition period.
FIREBASE_WEB_API_KEY=


# ── Email ─────────────────────────────────────────────────────────────────
# log = print emails to the console (default, safe for development); smtp = send for real.
MAIL_DRIVER=log
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Instant Doctor <no-reply@instantdoctor.co>
MAIL_REPLY_TO=support@instantdoctor.co
OPS_EMAIL=activities@instantdoctor.co

# Comma-separated audiences accepted on ID tokens.
# Google: web client (Android tokens are issued for it) + iOS client. Apple: the iOS bundle ID.
GOOGLE_CLIENT_IDS=127248616649-1k6h7gqq43a6aqn8aihkhdv31ic6h1gd.apps.googleusercontent.com,127248616649-tbh8pb8t6nl2ughnth8u50vee0nqvt17.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.instantdoctor.app

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" configured on the Flutterwave dashboard webhook settings
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=https://instantdoctor.co/payment/complete

EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_TTL_SECONDS=3600

TRIAL_DOCTOR_ID=p3rzihnMKVQVU6pIroy1nQ5anXK2
BOOKING_HOLD_MINUTES=30
BOOKING_MIN_LEAD_MINUTES=5

# ── File storage ───────────────────────────────────────────────────────────
# local = disk + served at PUBLIC_BASE_URL/files (dev only); r2 = Cloudflare R2.
STORAGE_DRIVER=local
# R2 → Manage API tokens → "Object Read & Write" token scoped to both buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (avatars, blog and product images): files get permanent URLs.
R2_PUBLIC_BUCKET=
# Private bucket (chat files, lab results, reports, doctor documents): no public access,
# served through signed links that expire after FILE_URL_TTL_SECONDS.
R2_PRIVATE_BUCKET=
# Public URL of the public bucket: custom domain (recommended) or its r2.dev URL.
R2_PUBLIC_URL=
UPLOAD_DIR=uploads
FILE_URL_TTL_SECONDS=3600
# How long a presigned direct-upload URL stays valid (seconds)
UPLOAD_URL_TTL_SECONDS=900
ENABLE_PUSH=true
# Swagger UI at /docs, OpenAPI spec at /openapi.json
API_DOCS_ENABLED=true
