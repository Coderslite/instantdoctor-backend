NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────────────────────────
# Switch targets with DB_TARGET (or per command: npm run dev:live, db:migrate:live, ...).
DB_TARGET=local
# MAMP MySQL defaults: user root / password root on port 8889
DATABASE_URL_LOCAL=mysql://root:root@127.0.0.1:8889/instant_doctor
# TiDB Cloud (Serverless): Connect → "General" → copy host/user/password, e.g.
# mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/instant_doctor
DATABASE_URL_LIVE=
# auto = TLS on for live, off for local. Set DATABASE_SSL_CA only for TiDB Dedicated.
DATABASE_SSL=auto
DATABASE_SSL_CA=
DATABASE_POOL_SIZE=10
# DATABASE_URL, if set, overrides all of the above (used by tests/containers).

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Service account JSON for FCM push + the one-off Firestore migration (never commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=../instantdoctorapi/serverKey.json
# Legacy Firebase web API key: lets migrated users log in with their Firebase password
# once, after which a local hash is stored. Remove after the transition period.
FIREBASE_WEB_API_KEY=

# Existing mail service (instantdoctorapi). Leave empty to disable outbound mail.
MAIL_SERVICE_URL=https://us-central1-instant-doctor-a4e4c.cloudfunctions.net/api

# Comma-separated audiences accepted on ID tokens.
# Google: web client (Android tokens are issued for it) + iOS client. Apple: the iOS bundle ID.
GOOGLE_CLIENT_IDS=127248616649-1k6h7gqq43a6aqn8aihkhdv31ic6h1gd.apps.googleusercontent.com,127248616649-tbh8pb8t6nl2ughnth8u50vee0nqvt17.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.instantdoctor.app

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" configured on the Flutterwave dashboard webhook settings
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REDIRECT_URL=https://instantdoctor.co/payment/complete

EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_TTL_SECONDS=3600

TRIAL_DOCTOR_ID=p3rzihnMKVQVU6pIroy1nQ5anXK2
BOOKING_HOLD_MINUTES=30
BOOKING_MIN_LEAD_MINUTES=5

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=15728640
ENABLE_PUSH=true
# Swagger UI at /docs, OpenAPI spec at /openapi.json
API_DOCS_ENABLED=true
