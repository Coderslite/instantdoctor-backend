{
  "name": "instantdoctor-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:live": "DB_TARGET=live tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:live": "DB_TARGET=live tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:live": "DB_TARGET=live drizzle-kit studio",
    "migrate:firestore": "tsx --env-file=.env scripts/firestore-migration/index.ts",
    "migrate:firestore:live": "DB_TARGET=live tsx --env-file=.env scripts/firestore-migration/index.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "pharmacy:create": "tsx --env-file=.env scripts/create-pharmacy.ts",
    "pharmacy:seed-categories": "tsx --env-file=.env scripts/seed-pharmacy-categories.ts",
    "blog:backfill": "tsx --env-file=.env scripts/backfill-blog.ts",
    "blog:reseed": "tsx --env-file=.env scripts/reseed-blog.ts",
    "storage:cors": "tsx --env-file=.env scripts/configure-storage-cors.ts"
  },
  "license": "UNLICENSED",
  "description": "Instant Doctor core API — SQL-backed replacement for the Firestore data layer of the patient app",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "country-region-data": "^4.1.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@eslint/js": "^9.39.0",
    "@express-rate-limit/tsconfig": "^1.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.6"
  }
}
